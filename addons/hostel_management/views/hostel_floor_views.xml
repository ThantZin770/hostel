<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hostel_floor_list" model="ir.ui.view">
        <field name="name">hostel.floor.list</field>
        <field name="model">hostel.floor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="building_id"/>
                <field name="section_ids"/>
            </list>
        </field>
    </record>

    <record id="view_hostel_floor_form" model="ir.ui.view">
        <field name="name">hostel.floor.form</field>
        <field name="model">hostel.floor</field>
        <field name="arch" type="xml">
            <form string="Floor">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Enter Name"/></h1>
                    </div>

                    <group>
                        <group string="Location Mapping">
                            <field name="section_ids"/>
                            <field name="building_id"/>
                        </group>
                         <group string="Primary Info">
                            <field name="gender"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Units">
                            <field name="unit_ids">
                                <list editable="bottom">
                                    <field name="name" string="Name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>