<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hostel_room_type_list" model="ir.ui.view">
        <field name="name">hostel.room.type.list</field>
        <field name="model">hostel.room.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_hostel_room_type_form" model="ir.ui.view">
        <field name="name">hostel.room.type.form</field>
        <field name="model">hostel.room.type</field>
        <field name="arch" type="xml">
            <form string="Room Type">
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Single"/>
                        </h1>
                    </div>
                    <group>
                        <field name="description" placeholder="Optional notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
