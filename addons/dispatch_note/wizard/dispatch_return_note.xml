<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="dispatch_return_note_view_form" model="ir.ui.view">
        <field name="name">dispatch_return_note_view_form_view_form</field>
        <field name="model">dispatch.return.note</field>
        <field name="arch" type="xml">
            <form string="dispatch_return_note_view_form_form">
                <sheet>
                    <group>
                        <field name="source_note_id"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="dispatch_qty"/>
                            <field name="return_qty"/>
                            <field name="uom_id"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_return_dispatch" type="object" string="Return"/>
                    <button name="action_return_all_dispatch" type="object" string="Return for All"
                            class="btn btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>