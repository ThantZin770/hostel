<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_profile_view_form" model="ir.ui.view">
        <field name="name">res_profile_view_form_view_form</field>
        <field name="model">res.profile</field>
        <field name="arch" type="xml">
            <form string="Profile">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="d-flex justify-content-end mb-2">
                        <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>

                    <group invisible="id">
                        <group string="Category">
                            <field name="partner_type"/>
                            <field name="visitor_sub_type"
                                   string="Sub Type"
                                   required="partner_type == 'visitor'"
                                   invisible="partner_type != 'visitor'"/>
                            <field name="employee_sub_type"
                                   string="Sub Type"
                                   required="partner_type == 'employee'"
                                   invisible="partner_type != 'employee'"/>
                            <field name="internship_sub_type"
                                   string="Sub Type"
                                   required="partner_type == 'internship'"
                                   invisible="partner_type != 'internship'"/>
                            <field name="third_parties_workforce_sub_type"
                                   string="Sub Type"
                                   required="partner_type == 'third_parties_workforce'"
                                   invisible="partner_type != 'third_parties_workforce'"/>
                            <field name="family_member_sub_type"
                                   string="Sub Type"
                                   required="partner_type == 'family_member'"
                                   invisible="partner_type != 'family_member'"/>
                            <field name="government_sub_type"
                                   string="Sub Type"
                                   required="partner_type == 'government'"
                                   invisible="partner_type != 'government'"/>
                        </group>
                    </group>

                    <group invisible="not id">
                        <group string="Category">
                            <field name="partner_type"/>
                        </group>
                        <group string="Sub Category">
                            <field name="visitor_sub_type"
                                   required="partner_type == 'visitor'"
                                   invisible="partner_type != 'visitor'"/>
                            <field name="employee_sub_type"
                                   required="partner_type == 'employee'"
                                   invisible="partner_type != 'employee'"/>
                            <field name="internship_sub_type"
                                   required="partner_type == 'internship'"
                                   invisible="partner_type != 'internship'"/>
                            <field name="third_parties_workforce_sub_type"
                                   required="partner_type == 'third_parties_workforce'"
                                   invisible="partner_type != 'third_parties_workforce'"/>
                            <field name="family_member_sub_type"
                                   required="partner_type == 'family_member'"
                                   invisible="partner_type != 'family_member'"/>
                            <field name="government_sub_type"
                                   required="partner_type == 'government'"
                                   invisible="partner_type != 'government'"/>
                        </group>
                    </group>

                    <group invisible="id" string="1. General Information">
                        <group>
                            <field name="name" string="Full Name"/>
                            <field name="job_position"/>
                            <field name="lang" string="Preferred Language"/>
                            <field name="host_employee_ids" widget="many2many_tags"/>
                            <field name="manager_id" invisible="partner_type != 'third_parties_workforce'"/>
                            <field name="website" invisible="profile_type != 'company'"/>
                        </group>
                        <group>
                            <field name="legal_name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="viber"/>
                            <field name="date_of_birth"/>
                            <field name="age" readonly="1"/>
                        </group>
                    </group>

                    <group invisible="id" string="2. Identity Information">
                        <group>
                            <field name="nationality_id"/>
                            <field name="nationality_type" readonly="1"/>
                            <field name="id_type" readonly="nationality_type == 'foreigner'"/>
                            <field name="passport_number" invisible="id_type != 'passport'"/>
                        </group>
                        <group invisible="id_type != 'nrc'">
                            <field name="township_code"/>
                            <field name="state_code"/>
                            <field name="nrc_number"/>
                            <field name="nrc_full_number" readonly="1"/>
                        </group>
                    </group>

                    <group invisible="id" string="3. Address Information">
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="state_id" domain="[('country_id', '=', country_id)]"/>
                            <field name="township_id" domain="[('state_id', '=', state_id)]"/>
                            <field name="city"/>
                        </group>
                    </group>

                    <group invisible="id" string="4. Specific Information">
                        <group>
                            <field name="employee_id" invisible="partner_type != 'employee'"/>
                            <field name="business_unit_id"
                                   invisible="partner_type not in ('employee', 'third_parties_workforce')"/>
                            <field name="department_id"
                                   invisible="partner_type not in ('employee', 'third_parties_workforce')"/>
                            <field name="position_title"
                                   invisible="partner_type not in ('employee', 'third_parties_workforce')"/>
                            <field name="join_date"
                                   invisible="partner_type not in ('employee', 'third_parties_workforce')"/>
                            <field name="resume_manager_id"
                                   invisible="partner_type not in ('employee', 'third_parties_workforce')"/>
                            <field name="working_address"
                                   invisible="partner_type not in ('employee', 'third_parties_workforce')"/>
                        </group>
                        <group>
                            <field name="academic_year" invisible="partner_type != 'internship'"/>
                            <field name="major_id" invisible="partner_type != 'internship'"/>
                            <field name="manager_profile_id" invisible="partner_type != 'internship'"/>
                            <field name="relationship_type_id" invisible="partner_type != 'family_member'"/>
                            <field name="employee_family_id"
                                   invisible="partner_type != 'family_member' or family_member_sub_type != 'employee_family_member'"/>
                            <field name="third_party_family_partner_id"
                                   invisible="partner_type != 'family_member' or family_member_sub_type != 'third_party_family_member'"/>
                            <field name="is_mass"/>
                        </group>
                    </group>

                    <notebook invisible="not id">
                        <page string="General Information">
                            <group string="Basic Information">
                                <group>
                                    <field name="name" string="Full Name"/>
                                    <field name="job_position"/>
                                    <field name="lang" string="Preferred Language"/>
                                    <field name="nationality_id"/>
                                    <field name="nationality_type" readonly="1"/>
                                    <field name="website" invisible="profile_type != 'company'"/>
                                    <field name="manager_id" invisible="partner_type != 'third_parties_workforce'"/>
                                    <field name="host_employee_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="street"/>
                                    <field name="street2"/>
                                    <field name="country_id"/>
                                    <field name="state_id" domain="[('country_id', '=', country_id)]"/>
                                    <field name="township_id" domain="[('state_id', '=', state_id)]"/>
                                    <field name="city"/>
                                </group>
                            </group>
                        </page>

                        <page string="Private Information">
                            <group string="Private Information">
                                <group>
                                    <field name="legal_name"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="viber"/>
                                    <field name="date_of_birth"/>
                                    <field name="age" readonly="1"/>
                                    <field name="religious_id"/>
                                    <field name="id_type" readonly="nationality_type == 'foreigner'"/>
                                    <field name="passport_number" invisible="id_type != 'passport'"/>
                                </group>
                                <group string="Emergency Contact Person">
                                    <field name="emergency_contact_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="name"/>
                                            <field name="phone"/>
                                            <field name="relative_text"/>
                                        </list>
                                    </field>
                                </group>
                            </group>
                            <group string="NRC Information" invisible="id_type != 'nrc'">
                                <group>
                                    <field name="country_id"/>
                                    <field name="state_id" domain="[('country_id', '=', country_id)]"/>
                                    <field name="township_id" domain="[('state_id', '=', state_id)]"/>
                                </group>
                                <group>
                                    <field name="township_code"/>
                                    <field name="state_code"/>
                                    <field name="nrc_number"/>
                                </group>
                                <div class="o_form_label">Full NRC</div>
                                <field name="nrc_full_number" readonly="1"/>
                            </group>
                            <group string="Employee Family Information" invisible="partner_type != 'family_member'">
                                <group>
                                    <field name="relationship_type_id"/>
                                    <field name="employee_family_id"
                                           invisible="family_member_sub_type != 'employee_family_member'"/>
                                    <field name="third_party_family_partner_id"
                                           invisible="family_member_sub_type != 'third_party_family_member'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Resume Information" invisible="partner_type not in ('employee', 'third_parties_workforce')">
                            <group>
                                <group>
                                    <field name="employee_id" invisible="partner_type != 'employee'"/>
                                    <field name="business_unit_id"/>
                                    <field name="department_id"/>
                                    <field name="position_title"/>
                                    <field name="join_date"/>
                                    <field name="resume_manager_id"/>
                                    <field name="job_position"/>
                                    <field name="working_address"/>
                                </group>
                            </group>
                            <group string="Working Experiences">
                                <field name="work_experience_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="company_name"/>
                                        <field name="position"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="description"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Skills &amp; Certifications">
                                <field name="skill_certification_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="level"/>
                                        <field name="issued_by"/>
                                        <field name="issue_date"/>
                                        <field name="expiry_date"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Driver License">
                                <field name="driver_license_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="license_type"/>
                                        <field name="license_number"/>
                                        <field name="issue_date"/>
                                        <field name="expiry_date"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Education">
                                <field name="education_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="institution"/>
                                        <field name="degree"/>
                                        <field name="year_from"/>
                                        <field name="year_to"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Internship Information" invisible="partner_type != 'internship'">
                            <group>
                                <group>
                                    <field name="academic_year" invisible="internship_sub_type != 'university'"/>
                                    <field name="major_id"/>
                                    <field name="manager_profile_id"/>
                                </group>
                            </group>
                        </page>

                        <page string="Pharmacy Information">
                            <group>
                                <group>
                                    <field name="blood_group"/>
                                    <field name="weight"/>
                                    <field name="height"/>
                                    <field name="remark"/>
                                </group>
                            </group>
                        </page>

                        <page string="Government Information" invisible="partner_type != 'government'">
                            <div class="o_form_label">Government specific fields will be added later.</div>
                        </page>

                        <page string="Assets Information">
                            <group>
                                <group>
                                    <field name="is_mass"/>
                                </group>
                            </group>
                        </page>

                        <page string="Mass Information" invisible="not is_mass">
                            <div class="o_form_label">Mass information fields will be added later.</div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_profile_action" model="ir.actions.act_window">
        <field name="name">Profile</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.profile</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': True}</field>
    </record>
</odoo>