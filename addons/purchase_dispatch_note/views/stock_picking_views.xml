<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="stock_picking_view_form_inherit_purchase_dispatch_note" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.purchase.dispatch.note</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="dispatch_note_id" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
