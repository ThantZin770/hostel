<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="people_directory_dashboard_action" model="ir.actions.client">
        <field name="name">People Dashboard</field>
        <field name="path">people-directory-dashboard</field>
        <field name="tag">people_directory_dashboard.dashboard</field>
    </record>

    <record id="people_directory_report_action" model="ir.actions.act_window">
        <field name="name">People Reports</field>
        <field name="res_model">res.profile</field>
        <field name="view_mode">pivot,graph,list,form</field>
    </record>

    <menuitem id="people_directory_dashboard_category"
              parent="people_directory.pepole_directory_root"
              name="Dashboard"
              sequence="10"
              action="people_directory_dashboard_action"/>

    <menuitem id="people_directory_reports_category"
              parent="people_directory.pepole_directory_root"
              name="Reports"
              sequence="300"
              action="people_directory_report_action"/>
</odoo>
