<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_aqua_core" model="ir.ui.view">
        <field name="name">res.company.form.inherit.aqua.core</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Aquaculture" name="aqua_core">
                    <group>
                        <group>
                            <field name="is_aqua_company"/>
                            <field name="aqua_company_type"/>
                            <field name="aqua_code"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_company_list_inherit_aqua_core" model="ir.ui.view">
        <field name="name">res.company.list.inherit.aqua.core</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='child_ids']" position="after">
                <field name="is_aqua_company" optional="show"/>
                <field name="aqua_company_type" optional="show"/>
                <field name="aqua_code" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
