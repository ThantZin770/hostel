<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_farm_list" model="ir.ui.view">
        <field name="name">aqua.farm.list</field>
        <field name="model">aqua.farm</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="location"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_aqua_farm_form" model="ir.ui.view">
        <field name="name">aqua.farm.form</field>
        <field name="model">aqua.farm</field>
        <field name="arch" type="xml">
            <form string="Aquaculture Farm / Site">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address">
                            <field name="address"/>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aqua_farm_search" model="ir.ui.view">
        <field name="name">aqua.farm.search</field>
        <field name="model">aqua.farm</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
