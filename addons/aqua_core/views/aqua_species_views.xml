<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_species_list" model="ir.ui.view">
        <field name="name">aqua.species.list</field>
        <field name="model">aqua.species</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="scientific_name"/>
                <field name="category"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_aqua_species_form" model="ir.ui.view">
        <field name="name">aqua.species.form</field>
        <field name="model">aqua.species</field>
        <field name="arch" type="xml">
            <form string="Aquaculture Species">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="scientific_name"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aqua_species_search" model="ir.ui.view">
        <field name="name">aqua.species.search</field>
        <field name="model">aqua.species</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="scientific_name"/>
                <field name="category"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
