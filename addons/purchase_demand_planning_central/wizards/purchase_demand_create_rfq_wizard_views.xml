<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_purchase_demand_plan_create_rfq_wizard_form" model="ir.ui.view">
        <field name="name">purchase.demand.plan.create.rfq.wizard.form</field>
        <field name="model">purchase.demand.plan.create.rfq.wizard</field>
        <field name="arch" type="xml">
            <form string="Create RFQ">
                <field name="has_mixed_preferred_vendors" invisible="1"/>
                <field name="has_missing_preferred_vendor" invisible="1"/>
                <div class="alert alert-info" role="alert"
                     invisible="has_mixed_preferred_vendors or has_missing_preferred_vendor">
                    All selected lines use the same preferred vendor. You can keep it, apply another vendor to all
                    lines, or change vendors line by line.
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="not has_mixed_preferred_vendors or has_missing_preferred_vendor">
                    Selected lines have different vendors. Review or change each line vendor before confirming.
                </div>
                <div class="alert alert-warning" role="alert" invisible="not has_missing_preferred_vendor">
                    Some selected lines do not have a vendor. Select a vendor for every line before confirming.
                </div>
                <group>
                    <field name="vendor_mode" widget="radio"/>
                    <field name="preferred_vendor_id"
                           invisible="vendor_mode != 'single'"
                           required="vendor_mode == 'single'"
                           context="{'res_partner_search_mode': 'supplier'}"/>
                </group>
                <group/>
                <field name="wizard_line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="1">
                        <field name="demand_reference" readonly="1"/>
                        <field name="product_id" width="120px" readonly="1"/>
                        <field name="approved_qty" width="150px" readonly="1"/>
                        <field name="rfq_qty"/>
                        <field name="uom_id" readonly="1"/>
                        <field name="no_remaining_qty" column_invisible="1"/>
                        <field name="preferred_vendor_id"
                               width="120px"
                               column_invisible="parent.vendor_mode == 'single'"
                               context="{'res_partner_search_mode': 'supplier'}"
                               required="parent.vendor_mode == 'multi'"/>
                        <button name="action_split_remaining"
                                string="Add Remaining"
                                width="150px"
                                icon="fa-plus"
                                type="object"
                                invisible="no_remaining_qty"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
